---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
import FAQ from '../components/FAQ.astro';

const faq = [
  { q: `How quickly will you reply to my message?`, a: `We aim to reply within [response time]. For anything urgent, call us on ${SITE.phone}.` },
  { q: `Can I book over the phone?`, a: `Yes. Call ${SITE.phone} during opening hours and we will book your session and answer any questions.` },
  { q: `Is there parking near Forge?`, a: `[Parking details]. We are also within walking distance of Wigan town centre.` },
  { q: `Can I change or cancel a booking?`, a: `Yes. [Cancellation and rescheduling policy].` },
];

const popular = [
  { href: '/gym-membership-wigan/', label: 'Gym membership' },
  { href: '/personal-trainer-wigan/', label: 'Personal training' },
  { href: '/sports-massage-wigan/', label: 'Sports massage' },
  { href: '/physiotherapy-wigan/', label: 'Physiotherapy' },
  { href: '/ice-bath-wigan/', label: 'Ice bath' },
  { href: '/infrared-sauna-wigan/', label: 'Infrared sauna' },
];
---

<Layout
  breadcrumbs={[{ name: 'Contact', path: '/contact/' }]}
  title="Contact Us | Forge Wellness & Recovery Wigan"
  description="Contact Forge Wellness & Recovery in Wigan. Book a gym tour, personal training, sports massage, physio or recovery session, or send us a question."
>

  <!-- Hero -->
  <section class="bg-forge-steel py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-white/60 tracking-widest uppercase mb-6 flex gap-2 items-center" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/70 transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">Contact</span>
      </nav>
      <h1 class="eyebrow !text-white text-sm sm:text-base mb-4">Contact Forge Wellness &amp; Recovery, Wigan</h1>
      <h2 class="font-display font-900 uppercase text-white leading-none mb-4" style="font-size:clamp(2.5rem,6vw,4.5rem);">
        Book a session.<br />
        <span class="text-forge-orange-l">We'll handle the rest.</span>
      </h2>
    </div>
  </section>

  <!-- Contact grid -->
  <section class="py-24 bg-forge-sand">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-5 gap-12">

        <!-- Left — info + hours -->
        <div class="lg:col-span-2 space-y-10">

          <!-- Contact details -->
          <div class="reveal">
            <h2 class="font-display font-700 uppercase text-xl tracking-wide text-forge-steel mb-6">Find us</h2>
            <ul class="space-y-5">
              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-forge-orange/10 text-forge-orange flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-0.5">Address</p>
                  <address class="not-italic text-forge-steel/80 leading-relaxed text-sm">
                    {SITE.fullAddress}
                  </address>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-forge-orange/10 text-forge-orange flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-0.5">Phone</p>
                  <a href={SITE.phoneHref} class="text-forge-orange-d font-semibold hover:underline transition-colors text-sm">
                    {SITE.phone}
                  </a>
                </div>
              </li>
              <li class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-forge-orange/10 text-forge-orange flex items-center justify-center flex-shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-0.5">Email</p>
                  <a href={SITE.emailHref} class="text-forge-orange-d font-semibold hover:underline transition-colors text-sm">
                    {SITE.email}
                  </a>
                </div>
              </li>
            </ul>
          </div>

          <!-- Opening hours -->
          <div class="bg-white rounded-2xl p-7 shadow-card reveal">
            <h3 class="font-display font-700 uppercase tracking-wide text-forge-steel mb-5">Opening Hours</h3>
            <ul class="space-y-3 text-sm">
              {SITE.hours.map(([day, hours]) => (
                <li class="flex justify-between border-b border-forge-steel/8 pb-3 last:border-0 last:pb-0">
                  <span class="text-forge-steel/80">{day}</span>
                  <span class="font-semibold text-forge-steel">{hours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Right — form -->
        <div class="lg:col-span-3 reveal">
          <div class="bg-white rounded-2xl p-8 shadow-card">
            <h2 class="font-display font-700 uppercase text-xl tracking-wide text-forge-steel mb-2">Send us a message</h2>
            <p class="text-forge-steel/80 text-sm mb-7">We aim to reply within 2 hours during opening hours.</p>

            <form id="contact-form" class="space-y-5" novalidate>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="name" class="block text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-2">Full Name *</label>
                  <input
                    type="text" id="name" name="name" required autocomplete="name"
                    class="w-full rounded-lg border border-forge-steel/20 bg-forge-sand px-4 py-3 text-sm text-forge-steel placeholder-forge-steel/30 focus:outline-none focus:ring-2 focus:ring-forge-orange focus:border-transparent transition-all"
                    placeholder="Your name"
                  />
                </div>
                <div>
                  <label for="email" class="block text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-2">Email *</label>
                  <input
                    type="email" id="email" name="email" required autocomplete="email"
                    class="w-full rounded-lg border border-forge-steel/20 bg-forge-sand px-4 py-3 text-sm text-forge-steel placeholder-forge-steel/30 focus:outline-none focus:ring-2 focus:ring-forge-orange focus:border-transparent transition-all"
                    placeholder="your@email.com"
                  />
                </div>
              </div>
              <div>
                <label for="phone" class="block text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-2">Phone</label>
                <input
                  type="tel" id="phone" name="phone" autocomplete="tel"
                  class="w-full rounded-lg border border-forge-steel/20 bg-forge-sand px-4 py-3 text-sm text-forge-steel placeholder-forge-steel/30 focus:outline-none focus:ring-2 focus:ring-forge-orange focus:border-transparent transition-all"
                  placeholder="07700 000000"
                />
              </div>
              <div>
                <label for="service" class="block text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-2">Service interested in</label>
                <select
                  id="service" name="service"
                  class="w-full rounded-lg border border-forge-steel/20 bg-forge-sand px-4 py-3 text-sm text-forge-steel focus:outline-none focus:ring-2 focus:ring-forge-orange focus:border-transparent transition-all appearance-none"
                >
                  <option value="">Select a service (optional)</option>
                  <option>Gym Membership</option>
                  <option>Personal Training</option>
                  <option>Sports Massage</option>
                  <option>Physiotherapy</option>
                  <option>Cold Water Immersion</option>
                  <option>Infrared Sauna</option>
                  <option>HYROX Training</option>
                  <option>Compression Therapy</option>
                  <option>Rugby Recovery</option>
                  <option>Sports Nutrition</option>
                  <option>General Enquiry</option>
                </select>
              </div>
              <div>
                <label for="message" class="block text-xs font-bold tracking-widest uppercase text-forge-steel/80 mb-2">Message *</label>
                <textarea
                  id="message" name="message" required rows="4"
                  class="w-full rounded-lg border border-forge-steel/20 bg-forge-sand px-4 py-3 text-sm text-forge-steel placeholder-forge-steel/30 focus:outline-none focus:ring-2 focus:ring-forge-orange focus:border-transparent transition-all resize-none"
                  placeholder="Tell us what you're looking to achieve..."
                ></textarea>
              </div>
              <div id="form-status" class="hidden rounded-lg px-4 py-3 text-sm font-semibold"></div>
              <button type="submit" class="btn-forge w-full justify-center" id="submit-btn">
                Send message
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.269 20.876L5.999 12zm0 0h7.5"/>
                </svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQ faq={faq} />

  <!-- Popular services (internal links) -->
  <section class="py-16 bg-white" aria-labelledby="popular-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <h2 id="popular-heading" class="font-display font-700 uppercase text-2xl tracking-wide text-forge-steel mb-6">Popular services in Wigan</h2>
      <ul class="flex flex-wrap justify-center gap-3">
        {popular.map(p => (
          <li><a href={p.href} class="inline-block rounded-full border border-forge-steel/20 px-4 py-2 text-sm font-semibold text-forge-steel hover:border-forge-orange hover:text-forge-orange-d transition-colors">{p.label}</a></li>
        ))}
        <li><a href="/services/" class="inline-block rounded-full bg-forge-steel px-4 py-2 text-sm font-semibold text-white hover:bg-forge-steel-m transition-colors">All services</a></li>
      </ul>
    </div>
  </section>

</Layout>

<script>
  import { SITE } from '../data/site';
  const form   = document.getElementById('contact-form') as HTMLFormElement;
  const status  = document.getElementById('form-status') as HTMLDivElement;
  const btn     = document.getElementById('submit-btn') as HTMLButtonElement;
  const ENDPOINT = 'https://script.google.com/macros/s/AKfycbw14wYSXu93tA6ho8rAgj0SyEghzorgqGUXemuUxsvgnKBN9Pg7REpIcMHiSECN32_z/exec';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Sending...';

    const data: Record<string, string> = {};
    new FormData(form).forEach((v, k) => { data[k] = v.toString(); });

    const fd = new FormData();
    Object.entries(data).forEach(([k, v]) => fd.append(k, v));

    try {
      await fetch(ENDPOINT, { method: 'POST', body: fd });
      status.className = 'rounded-lg px-4 py-3 text-sm font-semibold bg-green-50 text-green-800 border border-green-200';
      status.textContent = '✓ Message sent! We will be in touch shortly.';
      status.classList.remove('hidden');
      form.reset();
    } catch {
      status.className = 'rounded-lg px-4 py-3 text-sm font-semibold bg-red-50 text-red-800 border border-red-200';
      status.textContent = `Something went wrong. Please call us on ${SITE.phone}.`;
      status.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send message';
    }
  });
</script>
