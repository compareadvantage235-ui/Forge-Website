---
import { sized, srcset } from '../lib/img';
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';
import FAQ from '../components/FAQ.astro';
import JsonLd from '../components/JsonLd.astro';

// LocalBusiness schema (HealthClub is schema.org's LocalBusiness type for gyms).
const S = SITE.schema;
const siteUrl = new URL('/', Astro.site).href;
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HealthClub',
  '@id': `${siteUrl}#localbusiness`,
  name: SITE.name,
  url: siteUrl,
  image: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1200&q=80&auto=format',
  logo: S.logo,
  telephone: S.telephone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: S.streetAddress,
    addressLocality: S.addressLocality,
    postalCode: S.postalCode,
    addressCountry: S.addressCountry,
  },
  openingHours: S.openingHours,
  areaServed: { '@type': 'City', name: 'Wigan' },
  parentOrganization: { '@id': `${siteUrl}#organization` },
};

const faq = [
  { q: `What services does Forge offer in Wigan?`, a: `Forge Wellness & Recovery combines a gym with recovery and health services under one roof: gym membership, personal training, HYROX training, sports massage, physiotherapy, ice baths, infrared sauna, compression therapy, rugby recovery and sports nutrition coaching.` },
  { q: `Do I need a gym membership to use the recovery services?`, a: `No. Recovery services such as ice baths, infrared sauna, sports massage and physiotherapy can be booked on their own, without a gym membership.` },
  { q: `Is Forge suitable for beginners?`, a: `Yes. Forge is for anyone who wants to train and recover well, from complete beginners to competitive athletes. Our coaches and therapists will tailor every session to your level.` },
  { q: `What is the difference between an ice bath and an infrared sauna?`, a: `An ice bath uses cold water to reduce inflammation and muscle soreness after hard exercise. An infrared sauna uses gentle heat to relax muscles, improve circulation and help you unwind. Many people use both in the same visit.` },
  { q: `Where is Forge Wellness & Recovery?`, a: `We are at ${SITE.fullAddress}. [Parking and transport details].` },
  { q: `What are your opening hours?`, a: `${SITE.hours.map(([d, h]) => `${d}: ${h}`).join('. ')}.` },
];

const services = [
  {
    slug: 'gym-membership-wigan',
    name: 'Gym & Strength Floor',
    desc: 'State-of-the-art equipment, strength racks, and a performance-focused floor built for serious training.',
    img: 'https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600&q=80&auto=format&fit=crop',
    imgAlt: 'Dumbbell racks and strength equipment on a gym floor',
  },
  {
    slug: 'personal-trainer-wigan',
    name: 'Personal Training',
    desc: 'Expert coaches who build programmes around your goals — not generic templates.',
    img: 'https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=600&q=80&auto=format&fit=crop',
    imgAlt: 'Personal trainer coaching a client through a floor exercise',
  },
  {
    slug: 'sports-massage-wigan',
    name: 'Sports Massage',
    desc: 'Deep tissue and sports-specific massage to accelerate recovery and prevent injury.',
    img: 'https://images.unsplash.com/photo-1540205895360-4ad4cffb3aa8?w=600&q=80&auto=format&fit=crop',
    imgAlt: 'Sports massage therapist working on an athlete’s leg',
  },
  {
    slug: 'physiotherapy-wigan',
    name: 'Physiotherapy',
    desc: '[Accreditation] physios diagnosing and treating injuries to get you back performing.',
    img: 'https://images.unsplash.com/photo-1649751361457-01d3a696c7e6?w=600&q=80&auto=format&fit=crop',
    imgAlt: 'Physiotherapist assessing a patient’s leg on a treatment table',
  },
  {
    slug: 'ice-bath-wigan',
    name: 'Cold Water Immersion',
    desc: 'Cold plunge pools at precisely controlled temperatures for faster recovery.',
    img: 'https://images.unsplash.com/photo-1713270232602-bf8dc038d91c?w=600&q=80&auto=format&fit=crop',
    imgAlt: 'Man beside a metal ice bath tub filled with cold water',
  },
  {
    slug: 'infrared-sauna-wigan',
    name: 'Infrared Sauna',
    desc: 'Full-spectrum infrared therapy to detox, reduce inflammation, and improve sleep quality.',
    img: 'https://images.unsplash.com/photo-1605614307370-f7a1e58ae751?w=600&q=80&auto=format&fit=crop',
    imgAlt: 'Woman relaxing on a wooden sauna bench',
  },
];

const stats = [
  { num: '[number]', label: 'Active Members' },
  { num: '[number]', label: 'Specialist Practitioners' },
  { num: '[rating]', label: 'Google Rating' },
  { num: '6',        label: 'Recovery Modalities' },
  { num: '[year]',   label: 'Est. in Wigan' },
];

const testimonials = [
  // Placeholders: replace with real, attributed reviews only.
  { text: '[Customer review]', name: '[Customer name]', role: '[Member since year · sport]' },
  { text: '[Customer review]', name: '[Customer name]', role: '[Member since year · sport]' },
  { text: '[Customer review]', name: '[Customer name]', role: '[Member since year · sport]' },
];

const features = [
  { icon: '🏋️', label: 'No contracts' },
  { icon: '📍', label: 'Town centre location' },
  { icon: '🕕', label: '[Opening days]' },
  { icon: '🧊', label: 'Ice bath & sauna recovery' },
  { icon: '👥', label: '[number] specialist practitioners' },
  { icon: '⚡', label: 'HYROX training' },
];
---

<Layout
  preloadImage={{ srcset: srcset("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&q=80&auto=format&fit=crop", 1600, 60), sizes: "100vw" }}
  title="Gym & Recovery Centre Wigan | Forge Wellness & Recovery"
  description="Gym and recovery centre in Wigan. Gym membership, personal training, sports massage, physiotherapy, ice baths and infrared sauna under one roof."
>
  <JsonLd slot="schema" data={localBusiness} />


  <!-- ═══════════════════════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════════════════════ -->
  <section class="relative flex items-center bg-forge-steel overflow-hidden" aria-labelledby="hero-heading">

    <!-- Background image -->
    <img
      src={sized("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&q=80&auto=format&fit=crop", 960, 60)}
      srcset={srcset("https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1600&q=80&auto=format&fit=crop", 1600, 60)}
      sizes="100vw"
      alt=""
      aria-hidden="true"
      width="1600" height="900"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />

    <!-- Gradient overlay -->
    <div class="absolute inset-0 bg-hero-overlay"></div>

    <!-- Orange slash accent -->
    <div class="absolute top-0 right-0 w-1/3 h-full opacity-20 pointer-events-none">
      <div class="absolute inset-0 bg-orange-gradient" style="clip-path: polygon(25% 0, 100% 0, 100% 100%, 0% 100%);"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 py-14 lg:py-20 w-full">
      <div class="max-w-2xl">
        <!-- H1 = main search keyword (what Google ranks the page for). -->
        <h1 id="hero-heading" class="eyebrow !text-white text-sm sm:text-base mb-4 animate-fade-in">
          Gym &amp; Recovery Centre in Wigan
        </h1>
        <!-- H2 = brand slogan (keeps the big visual impact). -->
        <h2
          class="font-display font-900 uppercase text-white mb-5 leading-none tracking-wide"
          style="font-size:clamp(2.6rem,7vw,5.25rem);"
        >
          Train hard.<br />
          <span class="text-forge-orange-l">Recover harder.</span>
        </h2>
        <p class="text-white/75 text-lg leading-relaxed mb-8 max-w-xl">
          Gym membership, sports massage, physiotherapy, ice baths, infrared sauna
          and nutrition coaching — all under one roof in the heart of Wigan.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact/" class="btn-forge">Book your first session</a>
          <a href="/services/" class="btn-white">Explore services</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       STATS BAR
  ═══════════════════════════════════════════════════════════════ -->
  <div class="bg-forge-orange py-8" aria-label="Key figures">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-wrap justify-between gap-6">
        {stats.map(s => (
          <div class="text-center flex-1 min-w-[100px]">
            <p class="font-display font-800 text-3xl text-white leading-none tracking-wide">{s.num}</p>
            <p class="text-xs text-white tracking-widest uppercase mt-1">{s.label}</p>
          </div>
        ))}
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════
       FEATURE STRIP
  ═══════════════════════════════════════════════════════════════ -->
  <div class="bg-forge-sand-d border-b border-forge-steel/10 py-5">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex flex-wrap gap-6 justify-between">
        {features.map(f => (
          <div class="flex items-center gap-2 text-sm text-forge-steel/80 font-medium">
            <span class="text-base" aria-hidden="true">{f.icon}</span>
            {f.label}
          </div>
        ))}
      </div>
    </div>
  </div>


  <!-- ═══════════════════════════════════════════════════════════════
       SERVICES
  ═══════════════════════════════════════════════════════════════ -->
  <section class="py-24 bg-forge-sand" aria-labelledby="services-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="section-header reveal">
        <p class="eyebrow">What we offer</p>
        <h2 id="services-heading" class="font-display text-display-lg text-forge-steel mt-3 mb-4">
          Six ways to recover &amp; perform
        </h2>
        <p class="text-forge-steel/80 text-lg max-w-xl">
          Every service, every specialist, every piece of equipment — built to get you performing at your best.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
        {services.map(service => (
          <a
            href={`/${service.slug}/`}
            class="group relative overflow-hidden rounded-xl bg-forge-steel shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 block"
          >
            <!-- Image -->
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={sized(service.img, 960, 65, '4:3')}
                srcset={srcset(service.img, 960, 65, '4:3')}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                alt={service.imgAlt}
                width="600" height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <!-- Gradient overlay -->
              <div class="absolute inset-0 bg-card-overlay"></div>
              <!-- Orange bottom bar -->
              <div class="absolute bottom-0 left-0 right-0 h-1 bg-forge-orange scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <h3 class="font-display font-700 text-lg tracking-wide text-white uppercase mb-2 group-hover:text-forge-orange transition-colors duration-200">
                {service.name}
              </h3>
              <p class="text-white/60 text-sm leading-relaxed">
                {service.desc}
              </p>
              <div class="mt-4 flex items-center gap-2 text-forge-orange-xl text-xs font-bold tracking-widest uppercase">
                Learn more
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center reveal">
        <a href="/services/" class="btn-forge">View all services &amp; pricing</a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       WHY FORGE — SPLIT SECTION
  ═══════════════════════════════════════════════════════════════ -->
  <section class="py-24 bg-white" aria-labelledby="why-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">

        <!-- Image collage -->
        <div class="relative reveal">
          <div class="grid grid-cols-2 gap-4">
            <img
              src={sized("https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=500&q=80&auto=format&fit=crop", 640, 65, '3:4')}
              srcset={srcset("https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=500&q=80&auto=format&fit=crop", 640, 65, '3:4')}
              sizes="(min-width: 1024px) 25vw, 50vw"
              alt="Personal trainer coaching a client through a floor exercise"
              width="500" height="600"
              loading="lazy"
              decoding="async"
              class="rounded-xl w-full aspect-[3/4] object-cover object-top shadow-card"
            />
            <div class="flex flex-col gap-4 mt-8">
              <img
                src={sized("https://images.unsplash.com/photo-1595078475328-1ab05d0a6a0e?w=500&q=80&auto=format&fit=crop", 640, 65, '1:1')}
                srcset={srcset("https://images.unsplash.com/photo-1595078475328-1ab05d0a6a0e?w=500&q=80&auto=format&fit=crop", 640, 65, '1:1')}
                sizes="(min-width: 1024px) 25vw, 50vw"
                alt="Woman lifting a barbell in the gym"
                width="500" height="300"
                loading="lazy"
                decoding="async"
                class="rounded-xl w-full aspect-square object-cover shadow-card"
              />
              <div class="rounded-xl bg-forge-orange p-6 text-white text-center">
                <p class="font-display font-800 text-4xl leading-none">[rating]</p>
                <p class="text-sm text-white mt-1 tracking-wide uppercase font-semibold">Google Rating</p>
              </div>
            </div>
          </div>
          <!-- Floating badge -->
          <div class="absolute -bottom-5 -left-4 bg-forge-steel rounded-xl px-5 py-4 shadow-forge-lg hidden lg:block">
            <p class="font-display font-800 text-2xl text-white">[number]</p>
            <p class="text-xs text-white/60 tracking-widest uppercase">Active Members</p>
          </div>
        </div>

        <!-- Text -->
        <div class="reveal">
          <p class="eyebrow mb-4">Who we are</p>
          <h2 id="why-heading" class="font-display text-display-lg text-forge-steel mt-3 mb-6">
            Built for Wigan athletes
          </h2>
          <p class="text-forge-steel/80 text-lg leading-relaxed mb-6">
            Forge was built with one idea: serious athletes in Wigan deserve world-class recovery,
            not an afterthought corner with one foam roller. We've brought together [number] specialist
            practitioners under one roof to give you everything you need to train hard and recover harder.
          </p>
          <p class="text-forge-steel/80 leading-relaxed mb-8">
            From rugby league players and marathon runners to weekend cyclists and desk workers — if
            performance matters to you, Forge was built for you.
          </p>

          <ul class="space-y-4 mb-10">
            {[
              '[Accreditation] physiotherapy team',
              'Cold water immersion pools',
              'No contracts — book as you go',
              SITE.address,
            ].map(item => (
              <li class="flex items-start gap-3 text-forge-steel/80">
                <svg class="w-5 h-5 text-forge-orange mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a href="/about/" class="btn-forge">Meet the team</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       TESTIMONIALS
  ═══════════════════════════════════════════════════════════════ -->
  <section class="py-24 bg-forge-sand-d" aria-labelledby="reviews-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">

      <div class="section-header reveal text-center">
        <p class="eyebrow justify-center">Member reviews</p>
        <h2 id="reviews-heading" class="font-display text-display-lg text-forge-steel mt-3 mb-4">
          What our members say
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8 stagger">
        {testimonials.map(t => (
          <div class="bg-white rounded-2xl p-8 shadow-card hover:shadow-card-hover transition-shadow duration-300 relative">
            <!-- Large quote mark -->
            <div class="absolute top-6 right-6 text-forge-orange/10 font-display font-900 text-8xl leading-none select-none" aria-hidden="true">"</div>

            <blockquote class="text-forge-steel/80 leading-relaxed mb-6 relative z-10">
              "{t.text}"
            </blockquote>

            <div class="flex items-center gap-3">
              <div>
                <p class="font-semibold text-forge-steel text-sm">{t.name}</p>
                <p class="text-xs text-forge-steel/80">{t.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <FAQ faq={faq} />


  <!-- ═══════════════════════════════════════════════════════════════
       CTA BANNER
  ═══════════════════════════════════════════════════════════════ -->
  <section class="relative py-24 overflow-hidden bg-forge-steel" aria-label="Call to action">

    <!-- Background image -->
    <img
      src={sized("https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=1400&q=75&auto=format&fit=crop", 960, 35)}
      srcset={srcset("https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=1400&q=75&auto=format&fit=crop", 1600, 35)}
      sizes="50vw"
      alt=""
      aria-hidden="true"
      width="1400" height="600"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />

    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 text-center">
      <p class="eyebrow justify-center !text-white mb-4">Get started today</p>
      <h2 class="font-display font-900 text-white uppercase leading-none mb-6" style="font-size:clamp(2.2rem,5vw,4rem);">
        No contracts.<br />No pressure.
      </h2>
      <p class="text-white/70 text-lg max-w-lg mx-auto mb-10">
        Book a tour, try a recovery session, or start a gym membership. See for yourself what Forge can do for your training.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact/" class="btn-forge">Book your first session</a>
        <a href="/services/" class="btn-white">View all services</a>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════
       LOCATION PREVIEW
  ═══════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-white" aria-labelledby="location-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="eyebrow mb-4">Find us</p>
          <h2 id="location-heading" class="font-display text-display-lg text-forge-steel mt-3 mb-4">
            Right in the heart<br/>of Wigan
          </h2>
          <address class="not-italic text-forge-steel/80 leading-relaxed mb-8 space-y-2">
            <p class="font-semibold text-forge-steel">Forge Wellness &amp; Recovery</p>
            <p>{SITE.address}</p>
            <p class="mt-4">
              <a href={SITE.phoneHref} class="font-semibold text-forge-orange hover:text-forge-orange-d transition-colors">{SITE.phone}</a>
            </p>
          </address>
          <ul class="space-y-2 text-sm mb-8">
            {SITE.hours.map(([day, hours]) => (
              <li class="flex gap-4">
                <span class="text-forge-steel/80 w-24 flex-shrink-0">{day}</span>
                <span class="font-semibold text-forge-steel">{hours}</span>
              </li>
            ))}
          </ul>
          <a href="/contact/" class="btn-forge">Get directions</a>
        </div>

        <!-- Map placeholder with real image -->
        <div class="rounded-2xl overflow-hidden shadow-card reveal h-72 lg:h-auto">
          <img
            src={sized("https://images.unsplash.com/photo-1775993167571-cd1ff4cadada?w=800&q=80&auto=format&fit=crop", 960, 65)}
            srcset={srcset("https://images.unsplash.com/photo-1775993167571-cd1ff4cadada?w=800&q=80&auto=format&fit=crop", 960, 65)}
            sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
            alt="Cardio area with rows of treadmills"
            width="800" height="500"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

</Layout>
