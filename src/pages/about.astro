---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: 'James Thornton',
    role: 'Head of Performance',
    certs: 'MSc Sports Science · CIMSPA Senior Practitioner',
    img: 'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=400&q=80&auto=format&fit=crop&crop=face',
    bio: 'James founded Forge after 10 years working with elite rugby league clubs across the Super League.',
  },
  {
    name: 'Dr. Sarah Chen',
    role: 'Lead Physiotherapist',
    certs: 'PhD Physiotherapy · HCPC Registered',
    img: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=400&q=80&auto=format&fit=crop&crop=face',
    bio: 'Sarah specialises in sports injuries and post-surgical rehabilitation, with a focus on return-to-sport protocols.',
  },
  {
    name: 'Marcus Bell',
    role: 'Strength & Conditioning',
    certs: 'BSc Sport & Exercise Science · NSCA-CSCS',
    img: 'https://images.unsplash.com/photo-1567168544813-cc03465b4fa8?w=400&q=80&auto=format&fit=crop&crop=face',
    bio: 'Marcus builds strength and conditioning programmes for competitive athletes, from club to semi-professional level.',
  },
  {
    name: 'Amara Johnson',
    role: 'Sports Nutritionist',
    certs: 'MSc Sport Nutrition · SENr Accredited',
    img: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=400&q=80&auto=format&fit=crop&crop=face',
    bio: 'Amara creates evidence-based nutrition strategies for performance, body composition, and long-term health.',
  },
];

const values = [
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Evidence-based',
    desc: 'Every protocol we use is backed by peer-reviewed research. No fads, no gimmicks.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>`,
    title: 'Everyone welcome',
    desc: 'From professional athletes to people returning from injury — Forge is for anyone serious about progress.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/></svg>`,
    title: 'Performance-first',
    desc: 'Everything we build — equipment, protocols, programmes — is chosen to maximise what you can do.',
  },
  {
    icon: `<svg class="w-7 h-7" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/></svg>`,
    title: 'Rooted in Wigan',
    desc: 'We\'re a local business, proud of where we come from, committed to giving Wigan athletes the facilities they deserve.',
  },
];
---

<Layout
  title="About Forge Wellness & Recovery | Wigan's Premier Recovery Centre"
  description="Meet the team behind Forge Wellness & Recovery in Wigan. CIMSPA-registered practitioners, sports scientists, and performance coaches all under one roof."
  canonical="https://forge-wellness.netlify.app/about"
>

  <!-- Hero -->
  <section class="relative bg-forge-steel py-20 overflow-hidden">
    <img
      src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=1400&q=75&auto=format&fit=crop"
      alt=""
      aria-hidden="true"
      width="1400" height="400"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover opacity-15"
    />
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-white/40 tracking-widest uppercase mb-6 flex gap-2 items-center" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/70 transition-colors">Home</a>
        <span>/</span>
        <span class="text-white/70">About</span>
      </nav>
      <p class="eyebrow text-forge-orange mb-3">Our story</p>
      <h1 class="font-display font-900 uppercase text-white leading-none mb-4" style="font-size:clamp(2.5rem,6vw,4.5rem);">
        Built for athletes.<br />
        <span class="text-forge-orange">Built in Wigan.</span>
      </h1>
    </div>
  </section>

  <!-- Story section -->
  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <p class="eyebrow mb-4">Why we exist</p>
          <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-6">
            Wigan deserves better recovery facilities
          </h2>
          <div class="space-y-4 text-forge-steel/70 leading-relaxed">
            <p>
              Forge was born in 2022 from a simple frustration: Wigan's athletes — the rugby players, the
              marathon runners, the weekend warriors — had no place to access the recovery tools that
              professional athletes take for granted.
            </p>
            <p>
              Founder James Thornton spent 10 years working with Super League clubs and watched athletes
              transform their performance not just by training harder, but by recovering smarter. He
              wanted to bring that same approach to every athlete in Wigan, regardless of their level.
            </p>
            <p>
              Today, Forge has 1,200 members, 8 specialist practitioners, and Wigan's only
              HYROX-certified training facility — all at 8 Market Place, right in the town centre.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4 reveal">
          <img
            src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=500&q=80&auto=format&fit=crop"
            alt="Forge Wellness gym floor"
            width="500" height="400"
            loading="lazy"
            class="rounded-xl shadow-card col-span-2 w-full aspect-video object-cover"
          />
          <img
            src="https://images.unsplash.com/photo-1540555700478-4be289fbecef?w=400&q=80&auto=format&fit=crop"
            alt="Infrared sauna at Forge Wellness"
            width="400" height="300"
            loading="lazy"
            class="rounded-xl shadow-card w-full aspect-square object-cover"
          />
          <img
            src="https://images.unsplash.com/photo-1706197884196-eb9a8ea96d41?w=400&q=80&auto=format&fit=crop"
            alt="Cold water immersion at Forge Wellness"
            width="400" height="300"
            loading="lazy"
            class="rounded-xl shadow-card w-full aspect-square object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-24 bg-forge-sand-d">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="section-header reveal text-center">
        <p class="eyebrow justify-center">What drives us</p>
        <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-4">Our values</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger">
        {values.map(v => (
          <div class="bg-white rounded-2xl p-7 shadow-card hover:shadow-card-hover transition-shadow">
            <div class="w-12 h-12 rounded-xl bg-forge-orange/10 text-forge-orange flex items-center justify-center mb-5" set:html={v.icon}></div>
            <h3 class="font-display font-700 uppercase text-lg tracking-wide text-forge-steel mb-2">{v.title}</h3>
            <p class="text-forge-steel/60 text-sm leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="section-header reveal">
        <p class="eyebrow">The people behind Forge</p>
        <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-4">Meet the team</h2>
        <p class="text-forge-steel/60 text-lg max-w-xl">
          Every practitioner at Forge is fully qualified, registered with their professional body, and
          passionate about performance.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 stagger">
        {team.map(member => (
          <div class="group bg-forge-sand rounded-2xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1">
            <div class="relative overflow-hidden">
              <img
                src={member.img}
                alt={`${member.name}, ${member.role} at Forge Wellness`}
                width="400" height="400"
                loading="lazy"
                class="w-full aspect-square object-cover object-top transition-transform duration-500 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-card-overlay opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
            <div class="p-5">
              <h3 class="font-display font-700 uppercase text-lg tracking-wide text-forge-steel">{member.name}</h3>
              <p class="text-forge-orange text-xs font-bold tracking-widest uppercase mt-0.5">{member.role}</p>
              <p class="text-forge-steel/50 text-xs mt-1 mb-3">{member.certs}</p>
              <p class="text-forge-steel/65 text-sm leading-relaxed">{member.bio}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-forge-orange">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="font-display font-800 text-white uppercase text-display-lg mb-4">
        Come and meet us
      </h2>
      <p class="text-white/80 mb-8">
        Book a free tour of the facility and a consultation with one of our practitioners.
        No obligation, no sales pressure.
      </p>
      <a href="/contact" class="btn-white">Book a free tour</a>
    </div>
  </section>

</Layout>
