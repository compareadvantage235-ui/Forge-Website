---
import Layout from '../layouts/Layout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  slug: string;
  serviceName: string;
  heroHeading: string;
  heroSub: string;
  heroImg: string;
  heroImgAlt: string;
  whatIsIt: { heading: string; body: string };
  benefits: { icon: string; title: string; desc: string }[];
  pricing: { name: string; price: string; period: string; features: string[]; featured?: boolean }[];
  faq: { q: string; a: string }[];
  relatedServices: { href: string; name: string; img: string; imgAlt: string }[];
  breadcrumb: string;
}

const {
  title, description, canonical, slug,
  serviceName, heroHeading, heroSub,
  heroImg, heroImgAlt,
  whatIsIt, benefits, pricing, faq,
  relatedServices, breadcrumb,
} = Astro.props;
---

<Layout {title} {description} {canonical}>

  <!-- Hero -->
  <section class="relative bg-forge-steel py-20 overflow-hidden" aria-labelledby="page-heading">
    <img
      src={heroImg}
      alt=""
      aria-hidden="true"
      width="1400" height="500"
      loading="eager"
      class="absolute inset-0 w-full h-full object-cover opacity-20"
    />
    <div class="absolute inset-0 bg-hero-overlay"></div>
    <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6">
      <nav class="text-xs text-white/40 tracking-widest uppercase mb-6 flex gap-2 items-center flex-wrap" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white/70 transition-colors">Home</a>
        <span>/</span>
        <a href="/services" class="hover:text-white/70 transition-colors">Services</a>
        <span>/</span>
        <span class="text-white/70">{breadcrumb}</span>
      </nav>
      <p class="eyebrow text-forge-orange mb-3">Forge Wellness &amp; Recovery · Wigan</p>
      <h1 id="page-heading" class="font-display font-900 uppercase text-white leading-none mb-4" style="font-size:clamp(2.2rem,5.5vw,4rem);">
        <span set:html={heroHeading} />
      </h1>
      <p class="text-white/70 text-lg max-w-xl mb-8">{heroSub}</p>
      <div class="flex flex-wrap gap-4">
        <a href="/contact" class="btn-forge">Book a session</a>
        <a href="tel:+441942386400" class="btn-white">01942 386 400</a>
      </div>
    </div>
  </section>

  <!-- What is it -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="reveal">
          <p class="eyebrow mb-3">What it involves</p>
          <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-5">{whatIsIt.heading}</h2>
          <p class="text-forge-steel/70 leading-relaxed text-lg" set:html={whatIsIt.body} />
          <a href="/contact" class="btn-forge mt-8 inline-flex">Book your first session</a>
        </div>
        <div class="reveal">
          <img
            src={heroImg}
            alt={heroImgAlt}
            width="600" height="450"
            loading="lazy"
            class="rounded-2xl shadow-card w-full aspect-[4/3] object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-forge-sand-d">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="section-header reveal">
        <p class="eyebrow">Why it works</p>
        <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-4">The benefits</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 stagger">
        {benefits.map(b => (
          <div class="bg-white rounded-xl p-6 shadow-card hover:shadow-card-hover transition-shadow">
            <div class="text-3xl mb-4" aria-hidden="true">{b.icon}</div>
            <h3 class="font-display font-700 uppercase tracking-wide text-forge-steel mb-2">{b.title}</h3>
            <p class="text-forge-steel/60 text-sm leading-relaxed">{b.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="section-header reveal text-center">
        <p class="eyebrow justify-center">Transparent pricing</p>
        <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-4">Choose your plan</h2>
        <p class="text-forge-steel/60 max-w-md mx-auto">No hidden fees. No sign-up costs. Cancel or change any time.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 stagger">
        {pricing.map(plan => (
          <div class={`rounded-2xl p-7 flex flex-col shadow-card ${plan.featured ? 'bg-forge-orange text-white scale-105 shadow-forge-lg' : 'bg-forge-sand border border-forge-steel/10'}`}>
            {plan.featured && (
              <span class="text-xs font-bold tracking-widest uppercase bg-white/20 rounded-full px-3 py-1 self-start mb-4">Most popular</span>
            )}
            <h3 class={`font-display font-700 uppercase tracking-wide text-xl mb-1 ${plan.featured ? 'text-white' : 'text-forge-steel'}`}>{plan.name}</h3>
            <div class="mt-2 mb-5">
              <span class={`font-display font-900 text-4xl leading-none ${plan.featured ? 'text-white' : 'text-forge-steel'}`}>{plan.price}</span>
              <span class={`text-sm ml-1 ${plan.featured ? 'text-white/70' : 'text-forge-steel/50'}`}>{plan.period}</span>
            </div>
            <ul class="space-y-2.5 mb-7 flex-1">
              {plan.features.map(f => (
                <li class={`flex items-start gap-2.5 text-sm ${plan.featured ? 'text-white/85' : 'text-forge-steel/70'}`}>
                  <svg class={`w-4 h-4 mt-0.5 flex-shrink-0 ${plan.featured ? 'text-white' : 'text-forge-orange'}`} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                  </svg>
                  {f}
                </li>
              ))}
            </ul>
            <a href="/contact" class={plan.featured ? 'btn-white justify-center' : 'btn-forge justify-center'}>
              Book now
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-20 bg-forge-sand-d">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      <div class="section-header reveal text-center">
        <p class="eyebrow justify-center">Common questions</p>
        <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-4">
          Frequently asked questions
        </h2>
      </div>
      <div class="space-y-4 stagger">
        {faq.map((item, i) => (
          <details class="group bg-white rounded-xl shadow-sm overflow-hidden" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-semibold text-forge-steel hover:text-forge-orange transition-colors">
              {item.q}
              <svg class="w-5 h-5 text-forge-orange flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-forge-steel/70 leading-relaxed text-sm">
              {item.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related services -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="section-header reveal">
        <p class="eyebrow">Pair it with</p>
        <h2 class="font-display text-display-lg text-forge-steel mt-3 mb-4">Related services</h2>
      </div>
      <div class="grid sm:grid-cols-3 gap-6 stagger">
        {relatedServices.map(r => (
          <a href={r.href} class="group relative rounded-xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 hover:-translate-y-1 block aspect-[4/3]">
            <img
              src={r.img}
              alt={r.imgAlt}
              width="400" height="300"
              loading="lazy"
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-card-overlay"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5">
              <h3 class="font-display font-700 uppercase tracking-wide text-white group-hover:text-forge-orange transition-colors">{r.name}</h3>
              <span class="text-xs text-forge-orange font-bold tracking-widest uppercase flex items-center gap-1 mt-1">
                Learn more
                <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-forge-orange text-center">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      <h2 class="font-display font-800 text-white uppercase text-display-lg mb-4">
        Ready to book?
      </h2>
      <p class="text-white/80 mb-8">
        No contract required. Book a single session and see the difference for yourself.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="btn-white">Book {serviceName}</a>
        <a href="tel:+441942386400" class="inline-flex items-center gap-2 text-white/80 font-semibold hover:text-white transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          01942 386 400
        </a>
      </div>
    </div>
  </section>

</Layout>
