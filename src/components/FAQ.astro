---
import JsonLd from './JsonLd.astro';
// Reusable FAQ accordion (same look as the FAQ section in LandingPage.astro).
// Uses native <details>/<summary>, so it works with zero JavaScript.
interface Props {
  faq: { q: string; a: string }[];
  heading?: string;
  eyebrow?: string;
  bg?: string;
}
const {
  faq,
  heading = 'Frequently asked questions',
  eyebrow = 'Common questions',
  bg = 'bg-forge-sand-d',
} = Astro.props;

// FAQPage schema: the same questions and answers that are visible on the page.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<JsonLd data={faqSchema} />

<section class={`py-20 ${bg}`} aria-labelledby="faq-heading">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div class="section-header reveal text-center">
      <p class="eyebrow justify-center">{eyebrow}</p>
      <h2 id="faq-heading" class="font-display text-display-lg text-forge-steel mt-3 mb-4">{heading}</h2>
    </div>
    <div class="space-y-4 stagger">
      {faq.map((item, i) => (
        <details class="group bg-white rounded-xl shadow-sm overflow-hidden" open={i === 0}>
          <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer list-none font-semibold text-forge-steel hover:text-forge-orange transition-colors">
            {item.q}
            <svg class="w-5 h-5 text-forge-orange flex-shrink-0 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-5 pb-5 text-forge-steel/80 leading-relaxed text-sm">
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
