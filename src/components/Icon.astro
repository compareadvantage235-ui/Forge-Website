---
// Line icons (24×24, stroke-based, Lucide-style). Inline SVG = no extra downloads.
// `name` can be an icon name ('clock') or one of the emoji the content uses ('🕕'),
// so page data can stay as it is and still render a clean icon.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'w-6 h-6' } = Astro.props;

const ICONS: Record<string, string> = {
